# Deny-by-default (gitallow). Nothing is tracked unless a rule below re-includes
# it. Rules are evaluated in order and the last match wins, so the re-denials at
# the end override the allowances above them.

*
!*/

# --- allowed ------------------------------------------------------------------

!.gitignore
!justfile
!*.jl
!*.md
!*.toml
!*.yml
!*.yaml
!*.xml
!*.json
!*.bin
!*.sha256

# --- generated ----------------------------------------------------------------

Manifest.toml
/docs/build/
/docs/site/
*.jl.cov
*.jl.*.cov
*.jl.mem
lcov.info
/coverage/

# --- agent and specification working files (never committed) -------------------

/.agent/
/.claude/
/.specify/
/specs/
CLAUDE.md
AGENTS.md
spec.md

# --- local --------------------------------------------------------------------

.DS_Store
*.swp
*~
/refs/
/oracle/target/
